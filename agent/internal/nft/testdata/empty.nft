#!/usr/sbin/nft -f
# Generated by autoproxy-agent. Do not edit: rewritten on every apply.

table inet autoproxy_rules
delete table inet autoproxy_rules

table inet autoproxy_rules {
	map tcp_addr {
		type inet_service : ipv4_addr
		flags interval
	}
	map udp_addr {
		type inet_service : ipv4_addr
		flags interval
	}
	map tcp_remap {
		type inet_service : ipv4_addr . inet_service
	}
	map udp_remap {
		type inet_service : ipv4_addr . inet_service
	}
	set direct_targets {
		type ipv4_addr
		elements = { 10.66.66.2, 10.66.66.3 }
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "eth0" dnat ip to tcp dport map @tcp_remap
		iifname "eth0" dnat ip to udp dport map @udp_remap
		iifname "eth0" dnat ip to tcp dport map @tcp_addr
		iifname "eth0" dnat ip to udp dport map @udp_addr
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "wg0" ip daddr != @direct_targets masquerade
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		iifname "eth0" oifname "wg0" ct status dnat accept
	}

	chain tunnel_guard {
		type filter hook input priority filter - 10; policy accept;
		ip daddr 10.66.66.1 iifname != { "lo", "wg0" } drop
	}
}
